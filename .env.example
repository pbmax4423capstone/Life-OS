# Supabase — get these from your Supabase project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Anthropic key must be server-side only (Edge Function / Vercel function).
# Do NOT prefix with VITE_.
ANTHROPIC_API_KEY=your_server_side_anthropic_key_here
